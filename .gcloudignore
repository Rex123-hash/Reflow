# Cloud Run is built from a deliberately small backend-only context. Keep this
# as an allowlist so local credentials, UI assets, proof artifacts, and caches
# cannot enter the Cloud Build source archive.
**
!.gcloudignore
!.dockerignore
!Dockerfile
!pyproject.toml
!README.md
!uv.lock
!deployment/
!deployment/p2d/
!deployment/p2d/**
!deployment/p2g/
!deployment/p2g/**
!docs/
!docs/ui-fixtures/
!docs/ui-fixtures/**
!objective_recovery_agent/
!objective_recovery_agent/**
!src/
!src/**
