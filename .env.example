# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CALENDAR_ID=dedicated-demo-calendar-id
OPERATOR_DEMO_CALENDAR_EVENT_ID=p2goperator20260828
OBJECTIVE_RECOVERY_SERVICE_ACCOUNT=objective-recovery-app@your-gcp-project-id.iam.gserviceaccount.com
P1D_PUBSUB_TOPIC=objective-recovery-p1d

# Controlled Operator authorization is derived server-side in the BFF.
# Comma-separated SHA-256 hashes of approved Firebase UIDs; configure identically in BFF/backend.
OPERATOR_ALLOWED_SUBJECT_HASHES=

# Jira Cloud Operator adapter (store the token in Secret Manager in production).
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=operator-service-account@example.com
JIRA_API_TOKEN=secret-manager-only
JIRA_DEMO_ISSUE_KEY=REFLOW-1
# Assignment is DISABLED until permitted account IDs are explicitly configured and qualified.
JIRA_ALLOWED_ACCOUNT_IDS=

# Slack: optional PRIVATE BACKEND ONLY; never set these on BFF/frontend.
# SLACK_BOT_TOKEN is injected from objective-recovery-slack-bot-token:<pinned-version>.
# No token value belongs in this file or in chat. All three values are required to enable Slack.
SLACK_DEMO_CHANNEL_ID=
SLACK_TEAM_ID=

# Voice (V1 transcription, V2 Live Call): PRIVATE BACKEND ONLY; never set on BFF/frontend.
# Constrained ephemeral Live tokens - the only browser-safe credential for direct client
# streaming - are documented and implemented on the Gemini Developer API, and the Vertex
# client refuses to mint one. Voice therefore uses a separate Gemini API key from Secret
# Manager while the eight Reflow reasoning agents stay on Vertex. Voice reports
# VOICE_UNAVAILABLE while this is unset.
#
# NOT PROVISIONED. Before real user audio is enabled, confirm which Gemini Developer API
# billing and data-use tier this key belongs to, and describe retention and training
# behaviour no more broadly than the provider's own terms for that tier.
#
# The voice session layer does not persist raw microphone audio or transcription output
# before submission. Once submitted, the text is handled under the same existing rules as
# typed Operator input: redacted and bounded by safe_text, passed to the reasoning agents,
# hashed into the idempotency fingerprint rather than stored as a message, and logged as
# metadata only - and where the request becomes an action, the requested operation text is
# durably recorded in that action's receipt.
VOICE_GEMINI_API_KEY=secret-manager-only
# Optional bounded transcription bias. Unset uses the built-in Reflow term list.
VOICE_CUSTOM_VOCABULARY=

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here
