# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CALENDAR_ID=dedicated-demo-calendar-id
OPERATOR_DEMO_CALENDAR_EVENT_ID=p2goperator20260828
OBJECTIVE_RECOVERY_SERVICE_ACCOUNT=objective-recovery-app@your-gcp-project-id.iam.gserviceaccount.com
P1D_PUBSUB_TOPIC=objective-recovery-p1d

# Controlled Operator authorization is derived server-side in the BFF.
# Comma-separated SHA-256 hashes of approved Firebase UIDs; configure identically in BFF/backend.
OPERATOR_ALLOWED_SUBJECT_HASHES=

# Jira Cloud Operator adapter (store the token in Secret Manager in production).
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=operator-service-account@example.com
JIRA_API_TOKEN=secret-manager-only
JIRA_DEMO_ISSUE_KEY=REFLOW-1
# Assignment is DISABLED until permitted account IDs are explicitly configured and qualified.
JIRA_ALLOWED_ACCOUNT_IDS=

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here
