  "info": {
    "title": "Reflow Operator",
    "version": "p2f-v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/operator/actions/{action_id}/approve": {
      "post": {
        "parameters": [
          {
            "in": "path",
            "name": "action_id",
            "required": true,
            "schema": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorActionView"
                }
              }
            },
            "description": "Approved action result after execution and read-back"
          }
        }
      }
    },
    "/api/v1/operator/query": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OperatorQuery"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorResponse"
                }
              }
            },
            "description": "Validated reasoning or controlled action result"
          }
        }
      }
    }
  }
}
