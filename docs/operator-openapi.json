          "resource_type": {
            "enum": [
              "ISSUE",
              "EVENT",
              "OBJECTIVE",
              "CHANNEL"
            ],
            "title": "Resource Type",
            "type": "string"
          }
        },
        "required": [
          "authority",
          "resource_type",
          "resource_identifier"
        ],
        "title": "OperatorTarget",
        "type": "object"
      },
      "RequestedOperation": {
        "additionalProperties": false,
        "properties": {
          "calendar_event": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CalendarEventCreation"
              },
              {
