          },
          "facts": {
            "items": {
              "$ref": "#/components/schemas/OperatorFact"
            },
            "maxItems": 12,
            "title": "Facts",
            "type": "array"
          },
          "generated_at": {
            "title": "Generated At",
            "type": "string"
          },
          "human_response": {
            "$ref": "#/components/schemas/HumanResponse"
