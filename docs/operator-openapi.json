            "default": null,
            "title": "Comment"
          },
          "operation": {
            "enum": [
              "JIRA_TRANSITION",
              "JIRA_SET_PRIORITY",
              "JIRA_ASSIGN",
              "JIRA_SET_DUE_DATE",
              "JIRA_ADD_COMMENT",
              "CALENDAR_RESCHEDULE",
              "CALENDAR_UPDATE_TITLE",
              "CALENDAR_UPDATE_DESCRIPTION",
              "CREATE_CALENDAR_EVENT",
              "MOVE_PROTECTED_DEADLINE",
              "SLACK_INSPECT_CHANNEL",
              "SLACK_POST_MESSAGE"
