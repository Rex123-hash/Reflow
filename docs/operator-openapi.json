            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "revision": {
            "title": "Revision",
            "type": "integer"
          },
          "simulation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SimulationResult"
              },
              {
                "type": "null"
              }
            ],
            "default": null
