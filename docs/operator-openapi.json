            "type": "string"
          },
          "risk_critique": {
            "items": {
              "maxLength": 800,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 6,
            "minItems": 1,
            "title": "Risk Critique",
            "type": "array"
          },
          "scenario_summary": {
            "maxLength": 800,
            "minLength": 1,
            "title": "Scenario Summary",
            "type": "string"
          },
          "threatened_invariants": {
            "items": {
              "maxLength": 800,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 8,
            "title": "Threatened Invariants",
            "type": "array"
          },
          "unsupported_assumptions": {
            "items": {
              "maxLength": 800,
              "minLength": 1,
