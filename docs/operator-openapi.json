          },
          "incident_id": {
            "title": "Incident Id",
            "type": "string"
          },
          "inspection": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OperatorInspection"
              },
              {
                "type": "null"
              }
            ],
            "default": null
